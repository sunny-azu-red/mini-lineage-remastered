{
  "name": "mini-lineage",
  "version": "1.5.0",
  "description": "Mini-Lineage Remastered is a modern rewrite of the original Mini-Lineage game.",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/backend/server.js",
    "dev": "concurrently -n api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cross-env NODE_ENV=development nodemon backend/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "prod": "npm run build && npm run start",
    "prebuild": "npm run test",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:backend": "rm -rf dist/backend dist/scripts dist/database dist/version.txt && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tsc -p tsconfig.scripts.json && tsc-alias -p tsconfig.scripts.json && cp -r database dist/ && (echo ${APP_VERSION:-$(git rev-parse --short HEAD || echo 'unknown')}) > dist/version.txt",
    "ts": "ts-node -r tsconfig-paths/register",
    "db:migrate": "npm run ts -- scripts/db/migrate.ts",
    "db:fresh": "npm run ts -- scripts/db/reset.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Sunny",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.17.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.3.0",
    "@types/pino": "^7.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
