{
  "name": "mini-lineage",
  "version": "1.5.0",
  "description": "Mini-Lineage Remastered is a modern rewrite of the original Mini-Lineage game.",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.ts",
    "prod": "npm run build && npm start",
    "prebuild": "npm run test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tsc -p tsconfig.scripts.json && tsc-alias -p tsconfig.scripts.json && mkdir -p dist/view/template dist/public && cp -r src/view/template dist/view/ && cp -r database dist/ && cp public/favicon.ico dist/public/ && npm run min:css && npm run min:js && npm run min:html && (echo ${APP_VERSION:-$(git rev-parse --short HEAD || echo 'unknown')}) > dist/version.txt",
    "db:migrate": "node dist/scripts/db/migrate.js",
    "db:fresh": "node dist/scripts/db/reset.js",
    "db:migrate:dev": "ts-node -r tsconfig-paths/register scripts/db/migrate.ts",
    "db:fresh:dev": "ts-node -r tsconfig-paths/register scripts/db/reset.ts",
    "min:css": "node dist/scripts/min/css.js",
    "min:js": "node dist/scripts/min/js.js",
    "min:html": "node dist/scripts/min/html.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Sunny",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.17.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/clean-css": "^4.2.11",
    "@types/compression": "^1.8.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.18.2",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^25.3.0",
    "@types/pino": "^7.0.4",
    "@types/terser": "^3.8.1",
    "@vitest/coverage-v8": "^4.0.18",
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "nodemon": "^3.1.14",
    "terser": "^5.46.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
