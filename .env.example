PORT=3000

SESSION_SECRET=your-secret-here

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lineage_remastered
DB_USERNAME=root
DB_PASSWORD=pass

# Set automatically by the Dockerfile. Leave unset locally — it marks session
# cookies `secure`, which a plain-HTTP dev server cannot satisfy.
# IN_DOCKER=true

DEV_FRONTEND_PORT=5173
DEV_BACKEND_HOST=http://localhost

# --- Phoenix (game/) ---------------------------------------------------------
# Generate with: cd game && mix phx.gen.secret
SECRET_KEY_BASE=your-64-byte-secret-here
# The public hostname. force_ssl redirects to it, and it is excluded for localhost.
PHX_HOST=localhost
ELIXIR_PORT=4000
# The browser walkthrough creates characters and posts highscores, so it gets its own database.
TEST_DATABASE=lineage_remastered_test
E2E_PORT=4002
