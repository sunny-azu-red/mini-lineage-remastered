DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lineage_remastered
DB_USERNAME=root
DB_PASSWORD=pass

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=your-64-byte-secret-here

# The public hostname. force_ssl redirects to it, and excludes localhost.
PHX_HOST=localhost
PORT=4000

# The browser walkthrough creates characters and posts highscores, so it gets its own database.
TEST_DATABASE=lineage_remastered_test
E2E_PORT=4002
