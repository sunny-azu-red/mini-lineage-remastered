# The port the game listens on and the end 2 end tests read by e2e/serve.sh
PORT=4000
PORT_E2E=4002
PHX_HOST=localhost # public hostname: generated URLs use it, set it to the domain you deploy on

# Signs and encrypts the session cookie that ties a browser to its character
SECRET_KEY_BASE=your-64-byte-secret-here # generate your own with: mix phx.gen.secret

# The game creates no database of its own, so these must already exist (MariaDB or MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lineage_remastered # where you actually play: real characters, highscores and statistics
DB_DATABASE_TEST=lineage_remastered_test # `mix test` and the browser walkthrough both use this one instead
DB_USERNAME=root
DB_PASSWORD=pass

# Optional. A single URL may name the database instead of the DB_* keys above; the keys win when
# both are set, since a URL cannot carry a password with URL-unsafe characters unencoded.
# DATABASE_URL=ecto://user:pass@host:3306/lineage_remastered

# Optional. Database connections per node, and where a release looks for this file if not the
# working directory.
# POOL_SIZE=10
# ENV_FILE=/etc/mini-lineage/.env
