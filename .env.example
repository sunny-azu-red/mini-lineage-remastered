# The port the game listens on.
PORT=4000

# Public hostname. Generated URLs use it; set it to the domain you deploy on.
PHX_HOST=localhost

# Signs the session cookie. Generate one with: mix phx.gen.secret
SECRET_KEY_BASE=your-64-byte-secret-here

# A release creates no database; in development `mix setup` creates this one.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lineage_remastered
DB_USERNAME=postgres
DB_PASSWORD=pass

# What a kill's EXP, SP and Adena are multiplied by, whole numbers read at boot. Unset is retail's ×1; these are the private rates the game is balanced at (docs/rules.md §22).
EXP_RATE=5
SP_RATE=5
ADENA_RATE=20

# The zone the game's clock keeps: which hours are night (docs/rules.md §15) and every time and date it draws. Unset is UTC; what is stored is UTC whatever this says.
TIME_ZONE=Europe/Bucharest

# --- optional -----------------------------------------------------------------------------------

# A single URL in place of the DB_* keys above. The keys win when both are set.
# DATABASE_URL=ecto://user:pass@host:5432/lineage_remastered

# Database connections per node.
# POOL_SIZE=10

# Reach the database over IPv6.
# ECTO_IPV6=true

# How much the running game says. :info in production; :debug to watch the tick and every query.
# LOG_LEVEL=info
