# The port the game listens on.
PORT=4000

# The public hostname: generated URLs use it, and in a release force_ssl redirects http traffic to
# https://$PHX_HOST. localhost and 127.0.0.1 are excluded from that, so a plain-HTTP local server
# still works. Set it to the domain you deploy on.
PHX_HOST=localhost

# The browser walkthrough gets its own port, so it can never answer for a dev server already up.
# Read by e2e/serve.sh, which passes it to that server as PORT.
PORT_E2E=4002

# Signs and encrypts the session cookie that ties a browser to its character. Keep it secret, and
# generate your own with: mix phx.gen.secret
SECRET_KEY_BASE=your-64-byte-secret-here

# --- database -----------------------------------------------------------------------------------
# MariaDB or MySQL. The game creates no database of its own, so these must already exist.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=pass

# Where you actually play: real characters, highscores and statistics.
DB_DATABASE=lineage_remastered

# `mix test` and the browser walkthrough both use this one instead, because both create characters,
# spend adena and post highscores — never against the database above.
DB_DATABASE_TEST=lineage_remastered_test
