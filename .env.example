# The port the game listens on.
PORT=4000

# Public hostname. Generated URLs use it; set it to the domain you deploy on.
PHX_HOST=localhost

# Signs the session cookie. Generate one with: mix phx.gen.secret
SECRET_KEY_BASE=your-64-byte-secret-here

# The database must already exist — the game creates none.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lineage_remastered
DB_USERNAME=postgres
DB_PASSWORD=pass

# --- optional -----------------------------------------------------------------------------------

# A single URL in place of the DB_* keys above. The keys win when both are set.
# DATABASE_URL=ecto://user:pass@host:5432/lineage_remastered

# Database connections per node.
# POOL_SIZE=10

# Reach the database over IPv6.
# ECTO_IPV6=true

# How much the running game says. :info in production; :debug to watch the tick and every query.
# LOG_LEVEL=info

# Sliding-window throttling: 60 battles and 30 shop actions a minute, plus a 300/min flood limit.
# On in production, off everywhere else. Turn it off to load-test, and remember to turn it back on.
# RATE_LIMIT=true
