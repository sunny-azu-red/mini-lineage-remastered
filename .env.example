# Copy to .env and fill in. The app reads this file at boot, and a real environment variable
# always beats a line in it. `mix test` and `mix e2e` read .env.test instead — see
# .env.test.example — so they can point at another host entirely, not just another database.
#
# Every comment is on its own line on purpose: `docker run --env-file` does not strip a comment
# written after a value, and would read "localhost # public hostname" as the hostname.

# The port the game listens on. The browser suites get theirs from .env.test.
PORT=4000

# Public hostname. Generated URLs use it; set it to the domain you deploy on.
PHX_HOST=localhost

# Signs and encrypts the session cookie that ties a browser to its character.
# Generate your own with: mix phx.gen.secret
SECRET_KEY_BASE=your-64-byte-secret-here

# The game creates no database of its own, so these must already exist (MariaDB or MySQL).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lineage_remastered
DB_USERNAME=root
DB_PASSWORD=pass

# Where you actually play: real characters, highscores and statistics.


# --- optional -----------------------------------------------------------------------------------

# A single URL may name the database instead of the DB_* keys above. The keys win when both are
# set, since a URL cannot carry a password with URL-unsafe characters unless they are encoded.
# DATABASE_URL=ecto://user:pass@host:3306/lineage_remastered

# Database connections per node.
# POOL_SIZE=10

# Connect to the database over IPv6.
# ECTO_IPV6=true

# ENV_FILE does NOT belong here. It says which file to read, so it is only ever read from the
# real environment — by the time this file is open, the path has already been chosen:
#   ENV_FILE=/etc/mini-lineage/.env bin/mini_lineage start
