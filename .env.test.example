# The port the browser suites serve on.
PORT=4002

# Emptied by every run. Any name, any server — the reset refuses only the one .env names.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lineage_remastered_test
DB_USERNAME=postgres
DB_PASSWORD=pass

# The private rates the game is balanced at (docs/rules.md §22), which the suites and the bench play.
EXP_RATE=5
SP_RATE=5
ADENA_RATE=20

# The zone the game's clock keeps: which hours are night (docs/rules.md §15) and every time and date it draws. Unset is UTC; what is stored is UTC whatever this says.
TIME_ZONE=Europe/Bucharest

# --- optional -----------------------------------------------------------------------------------

# No SECRET_KEY_BASE here: :test takes one from config/test.exs and :e2e from config/dev.exs.
# POOL_SIZE, ECTO_IPV6 and DATABASE_URL are read only in :prod, so they would do nothing either.

# Turn this up to watch the tick and every query while a browser suite runs.
# LOG_LEVEL=debug
