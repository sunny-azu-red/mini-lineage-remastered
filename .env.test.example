# The throwaway database and the port the browser suites use. Read whenever MIX_ENV is test or
# e2e, so `mix test` and `mix e2e` never touch the database you actually play on.
#
# Same key names as .env on purpose: which file is read decides which database you get, so nothing
# here needs a _TEST suffix.

PORT=4002

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=pass

# `mix test` and the browser suites both use this, and empty its board as they go. The reset
# script refuses any database whose name does not end in _test.
DB_DATABASE=lineage_remastered_test
