<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
        <title>Mini Lineage - <%= title %>
        </title>
        <link rel="icon" href="/favicon.ico" type="image/x-icon">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@300;400;500&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
        <% if (isRelease) { %>
            <link href="/style.css" rel="stylesheet" type="text/css">
        <% } else { %>
            <link href="/css/tokens.css" rel="stylesheet" type="text/css">
            <link href="/css/base.css" rel="stylesheet" type="text/css">
            <link href="/css/layout.css" rel="stylesheet" type="text/css">
            <link href="/css/forms.css" rel="stylesheet" type="text/css">
            <link href="/css/tables.css" rel="stylesheet" type="text/css">
            <link href="/css/buttons.css" rel="stylesheet" type="text/css">
            <link href="/css/components.css" rel="stylesheet" type="text/css">
        <% } %>
        <script nonce="<%= cspNonce %>">
            window.CONFIG = JSON.parse('<%- JSON.stringify(config) %>');
            try {
                var h = sessionStorage.getItem('mini_last_hp_pct');
                var x = sessionStorage.getItem('mini_last_xp_pct');
                if (h !== null || x !== null) {
                    var s = document.createElement('style');
                    s.id = 'sidebar-init-style';
                    s.textContent = (h !== null ? '#hp-bar { width: ' + h + '% !important; transition: none !important; } ' : '') +
                                    (x !== null ? '#xp-bar { width: ' + x + '% !important; transition: none !important; } ' : '') +
                                    '#sidebar .animate-val, #sidebar .animate-adena { visibility: hidden; }';
                    document.head.appendChild(s);
                }
            } catch (e) {}
        </script>
    </head>

    <body>
        <div id="app">
            <div id="wrapper">
                <div id="header">
                    <% if (headerClickable) { %>
                        <a href="/" id="header-link"><%- include('partials/header') %></a>
                    <% } else { %>
                        <%- include('partials/header') %>
                    <% } %>
                </div>

                <div id="content">
                    <div id="sidebar">
                        <%- statusHtml %>
                        <%- inventoryHtml %>
                    </div>

                    <div id="main">
                        <div class="panel">
                            <div class="panel-header flex">
                                <span class="header-name"><%= title %></span>
                                <div class="header-effects" id="effects">
                                    <%- effectsHtml %>
                                </div>
                            </div>

                            <div class="panel-body">
                                <% if (lowHealthAlert) { %>
                                    <div id="low-health-alert" class="alert alert-danger">
                                        <%- lowHealthAlert %>
                                    </div>
                                <% } %>

                                <%- include('partials/alert', { flash }) %>

                                <%- mainContent %>
                            </div>
                        </div>

                        <div id="copyright"><%- version %> &copy; 2005 &ndash; <%= year %></div>
                    </div>
                </div>

            </div>
        </div>
        <% if (isRelease) { %>
            <script src="/script.js"></script>
        <% } else { %>
            <script src="/socket.io/socket.io.js"></script>
            <script src="/js/common.js"></script>
            <script src="/js/socket.js"></script>
            <script src="/js/sidebar.js"></script>
            <script src="/js/home.js"></script>
            <script src="/js/suicide.js"></script>
            <script src="/js/shop.js"></script>
        <% } %>
    </body>

</html>
