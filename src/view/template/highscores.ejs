<div class="action-links top">
    <a href="/highscores" class="btn btn-secondary btn-sm<% if (activeRaceId === undefined) { %> active<% } %>">All</a>
    <% races.forEach(function(race) { %>
        <a href="/highscores/<%= slugify(race.label) %>" class="btn btn-secondary btn-sm<% if (activeRaceId === race.id) { %> active<% } %>">
            <%= race.emoji %> <%= race.label %>
        </a>
    <% }); %>
</div>

<% if (rows.length > 0) { %>
    <div class="table-container">
        <table class="data-table" style="min-width: 545px">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="center">Level</th>
                    <th>Total XP</th>
                    <th>Wealth</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <% rows.forEach(function(row) { %>
                    <tr>
                        <td>
                            <%= row.name %>
                        </td>
                        <td class="center">
                            <%= row.level %>
                        </td>
                        <td class="xp">
                            <%= row.totalXp %>
                        </td>
                        <td class="gold">
                            🪙 <%= row.adena %>
                        </td>
                        <td class="muted">
                            <%= row.date %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>
<% } else { %>
    <p>
        The halls are silent. No soul has yet earned a place among these hallowed pillars. The chronicle of champions awaits its first entry.
        Will your name be the first to echo through eternity?
    </p>
<% } %>

<p class="last">
    <a href="/"><%= isGameStarted ? 'Continue your journey' : 'Go back to game start' %></a>
</p>
