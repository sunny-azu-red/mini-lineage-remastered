<div class="panel status-panel">
    <div class="panel-header flex">
        <span class="header-name"><%= playerName %></span>
    </div>
    <div class="panel-body small">
        <div class="stat-row">
            <span class="stat-label">Race</span>
            <span class="stat-value"><%- levelDisplay %></span>
        </div>
        <div class="stat-row bar <% if (isLowHealth) { %>danger<% } %>">
            <span class="stat-label">HP</span>
            <div class="bar-track" id="hp-track">
                <div class="bar hp-bar" id="hp-bar" <%- `style="width: ${hpPercent}%;"` %> data-pct="<%= hpPercent %>"></div>
                <span class="bar-text">
                    <span class="animate-val" data-val="<%= hp %>"><%= hpFormatted %></span>/<span id="status-max-hp"><%= maxHpFormatted %></span>
                </span>
            </div>
        </div>
        <div class="stat-row bar">
            <span class="stat-label">XP</span>
            <div class="bar-track">
                <div class="bar xp-bar" id="xp-bar" <%- `style="width: ${isMaxLevel ? 100 : xpPercent}%;"` %> data-pct="<%= isMaxLevel ? 100 : xpPercent %>" data-level="<%= level %>"></div>
                <span class="bar-text">
                    <% if (isMaxLevel) { %>
                        <span class="animate-val" data-val="<%= totalXp %>"><%= totalXpFormatted %></span>
                    <% } else { %>
                        <span class="animate-val" data-val="<%= currentXp %>"><%= currentXpFormatted %></span>/<%= nextLevelXpFormatted %>
                    <% } %>
                </span>
            </div>
        </div>
        <div class="stat-row">
            <span class="stat-label">Adena</span>
            <span class="stat-value gold">🪙 <span class="animate-adena" data-val="<%= adena %>"><%= adenaFormatted %></span></span>
        </div>
    </div>
</div>
